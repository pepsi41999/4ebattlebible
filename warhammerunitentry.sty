% Following are the unit entry commands. There are three types, standard, u, vehicle, v, and walker, w
% When called they store the unit name, statline, type, and unit composition with a single command, as well as log the type of entry
% When the makeentry command is called, entryuvw will be used to determine how to process and print the information.

\NewDocumentCommand{\uentry}{smm} {%regularunit
    \seq_put_right:Nn \entryuvw_wue {u}
    \seq_put_right:Nn \itemunitname_wue {#2}
	\seq_put_right:Nn \itemstatline_wue {#3}
	% \seq_put_right:Nn \itemunittype {#4}
	% \seq_put_right:Nn \itemunitcomp {#5}
    \int_incr:N \unitcount_wue
}


\NewDocumentCommand{\ventry}{smm} {%vehicle entry
    \seq_put_right:Nn \entryuvw_wue  {v}
    \seq_put_right:Nn \itemunitname_wue  {#2}
	\seq_put_right:Nn \itemstatline_wue  {#3}
	% \seq_put_right:Nn \unittype {#4}
	% \seq_put_right:Nn \unitcomp {#5}
    \int_incr:N \unitcount_wue 
}

\NewDocumentCommand{\wentry}{smm} {%walker entry
    \seq_put_right:Nn \entryuvw_wue  {w}
    \seq_put_right:Nn \itemunitname_wue  {#2}
	\seq_put_right:Nn \itemstatline_wue  {#3}
	% \seq_put_right:Nn \unittype {#4}
	% \seq_put_right:Nn \unitcomp {#5}
    \int_incr:N \unitcount_wue 
}

% % propery lists are like dictionarys with keys and indexes
\prop_new:N \tablestart_wue%makes a new property list

% define the table starting sequence for for entryuvw==u
\prop_put:Nnn \tablestart_wue {u}{
\begin{tabularx}{\linewidth}{ X C C C C C C C C C }
& {\bfseries WS} & {\bfseries BS} & {\bfseries S} & {\bfseries T} & {\bfseries W} & {\bfseries I} & {\bfseries A} & {\bfseries Ld} & {\bfseries Sv} \\
}
% define the table starting sequence for for entryuvw==v
\prop_put:Nnn \tablestart_wue {v}{
\begin{tabularx}{\linewidth}{ X B V }
& {\bfseries \reflectbox{\textlnot}Armour\textlnot} &
\end{tabularx}\\
\begin{tabularx}{\linewidth}{ X V V V V V}
& {\bfseries BS} & {\bfseries Front} & {\bfseries Side} & {\bfseries Rear} & {\bfseries Hp} \\
}
% define the table starting sequence for for entryuvw==w
\prop_put:Nnn \tablestart_wue {w}{
\begin{tabularx}{\linewidth}{ X A A }
& {\bfseries \reflectbox{\textlnot}Armour\textlnot} &
\end{tabularx}\\
\begin{tabularx}{\linewidth}{ X C C C C C C C C C }
& {\bfseries WS} & {\bfseries BS} & {\bfseries S} & {\bfseries F} & {\bfseries S} & {\bfseries R} & {\bfseries I} & {\bfseries A} & {\bfseries Hp} \\
}

% % the makeentry command begins processing of entry date, and prints it out into a unit entry.
%The normal use will print a full unit entry page formatting all the details
%calling \makeentry* will result in just the statline formatted for the current linewidth.
\NewDocumentCommand{\makeentry}{s}{
    \group_begin:
    \IfBooleanTF {#1} {%star
        \parbox[t]{\linewidth}{%
            \make_entryline_wue:n {}%calls the helper function responsible for printing the unit profile
        }\\%endparbox
    } {%nostar
    	\parbox[t]{\linewidth}{
            \seq_if_empty:NF \itemname_wue {%prints the unit name
                {\large\bfseries \seq_item:Nn \itemname_wue {1}} \dotfill {\large\bfseries \seq_item:Nn \itempoints_wue {1}}\\
            }
            % \seq_if_empty:NF \itemnote_wue {%prints the note
            %     \seq_item:Nn \itemnote_wue {1}\\\\
            % }
            \filldetails_wue:n {}%calls the helper function responsible for printing the wargear, options, and the like.
        }%endparbox
    }
    \group_end:
    \clearentrys_wue:n {}%clears an resets all variables for next usage.
}

% % a helper function used to keep the core of makefuntion readable. This is responsible for printing the unit profile
\cs_new_protected:Nn \make_entryline_wue:n {
	\setlength{\tabcolsep}{0pt}
    \renewcommand{\arraystretch}{1.2}
    % N C C C C C C C C C C T U for organics
	% N C C C A for armour
    % N C C C C C C C C C C T U for walkers
    % N C A for armour
    %  N C C C C C B T U  for vehicles
    \newcolumntype{N}{>{\hsize=28ex \raggedright\arraybackslash}X}%Name
    \newcolumntype{C}{>{\hsize=5ex \centering\arraybackslash}X}%Char
    \newcolumntype{V}{>{\hsize=8ex \centering\arraybackslash}X}%Vehiclechar
    \newcolumntype{T}{>{\hsize=36ex \raggedright\arraybackslash}X}%Type
    \newcolumntype{U}{>{\hsize=30ex \raggedright\arraybackslash}X}%UComp
    \newcolumntype{A}{>{\hsize=15ex \centering\arraybackslash}X}%Armour
    \newcolumntype{B}{>{\hsize=25ex \centering\arraybackslash}X}%Bigarmour
	%build rows 
	\int_step_inline:nnnn { 1 } { 1 } {\unitcount_wue}{
        \tl_set:Nx \templist_wue {\seq_item:Nn \entryuvw_wue {##1}}
    	\int_compare:nNnTF{##1}{=}{1}{
            \prop_get:NVN \tablestart_wue \templist_wue \tablebody_wue
        }{
        	\tl_set:Nx \templista_wue {\seq_item:Nn \entryuvw_wue {##1-1}}%get last type
            \tl_set:Nx \templistb_wue {\seq_item:Nn \entryuvw_wue {##1}}%get current type
        	\tl_if_eq:NNF {\templista_wue} {\templistb_wue} {
            	    \tl_put_right:Nn \tablebody_wue {\end{tabularx}\\} % end of the table
    				\prop_get:NVN \tablestart_wue \templist_wue \templist_wue%start new table
                    \tl_put_right:NV \tablebody_wue \templist_wue
            }
        }
		\tl_set:Nx \templist_wue {\seq_item:Nn \itemstatline_wue {##1}}%extract stat line and place in token list
        \tl_replace_all:Nnn \templist_wue {~}{&}%replace all spaces with &
    	\tl_put_right:Nn \tablebody_wue {
            \seq_item:Nn \itemunitname_wue {##1} &
        }
        \tl_put_right:Nx \tablebody_wue {
            \tl_use:N \templist_wue \\ %re-insert the new & separated stat line
        }
     %    \tl_put_right:Nn \tablebody {
     %        \seq_item:Nn \itemunittype_wue  {##1} &
     %        \seq_item:Nn \itemunitcomp_wue  {##1} \\
     %    }
    }
    \tl_put_right:Nn \tablebody_wue { \end{tabularx} } % end of the table
    \tl_use:N \tablebody_wue % print the table
}

% % a helper function used to keep the core of makefuntion readable. This is responsible for printing the weapons, options, and the like
\cs_new_protected:Nn \filldetails_wue:n {

    \seq_if_empty:NF \itemdescr_wue {%prints the description
        \parbox[t]{\linewidth}{
            \textit{\seq_item:Nn \itemdescr_wue{1}}
        }\\\\%endparbox
    }

    \seq_if_empty:NF \itemnote_wue {%prints the note
        \parbox[t]{\linewidth}{%
            \raggedright
            \setlength{\parskip}{5.0pt plus 2.0pt}
            \seq_item:Nn \itemnote_wue{1}
        }\\\\%endparbox
    }

	\parbox{\linewidth}{%
    \begin{multicols}{2}%
    \seq_if_empty:NF \entryuvw_wue {%prints the statline
        \parbox[t]{\linewidth}{%
            \make_entryline_wue:n {}%calls the helper function responsible for printing the unit profile
        }\\\\%endparbox
    }

    \seq_if_empty:NF \itemcomposition_wue {
        \parbox[t]{\linewidth}{
            \raggedright
            \textbf{\rule{0em}{1.5em} \seq_item:Nn \itemcomposition_wue {1}}\\
            \seq_item:Nn \itemcomposition_wue {2}
        }\\\\%endparbox
    }

    \begin{multicols}{2}
    \seq_if_empty:NF \itemunitcomp_wue {
        \parbox[t]{\linewidth}{
            \raggedright
            \textbf{\rule{0em}{1.5em} \seq_item:Nn \itemunitcomp_wue {1}}\\
            \seq_item:Nn \itemunitcomp_wue {2}%
        }\\\\%endparbox
    }%
    
    \seq_if_empty:NF \itemunittype_wue {
        \parbox[t]{\linewidth}{
            \raggedright
            \textbf{\rule{0em}{1.5em} \seq_item:Nn \itemunittype_wue {1}}\\
            \seq_item:Nn \itemunittype_wue {2}%
        }\\\\%endparbox
    }

    \seq_if_empty:NF \itemwargear_wue {
        \parbox[t]{\linewidth}{
            \raggedright
            \textbf{\rule{0em}{1.5em} \seq_item:Nn \itemwargear_wue {1}}\\
            \seq_item:Nn \itemwargear_wue {2}%
        }\\\\%endparbox
    }

    \seq_if_empty:NF \itemsrules_wue {
        \parbox[t]{\linewidth}{%
        	\raggedright
            \textbf{\rule{0em}{1.5em} \seq_item:Nn \itemsrules_wue {1}}\\
            \seq_item:Nn \itemsrules_wue {2}
        }\\\\%endparbox
    }

    \seq_if_empty:NF \itempsyker_wue {
        \parbox[t]{\linewidth}{
        	\raggedright
            \textbf{\rule{0em}{1.5em} \seq_item:Nn \itempsyker_wue {1}}\\
            \seq_item:Nn \itempsyker_wue {2}
        }\\\\%endparbox
    }

    \seq_if_empty:NF \itemtransport_wue {
        \parbox[t]{\linewidth}{
            \raggedright
            \textbf{\rule{0em}{1.5em} \seq_item:Nn \itemtransport_wue {1}}\\
            \seq_item:Nn \itemtransport_wue {2}
        }\\\\%endparbox
    }
    \end{multicols}%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

    \seq_if_empty:NF \itemmarks_wue {
        \parbox[t]{\linewidth}{
            \raggedright
            \textbf{\rule{0em}{1.5em} \seq_item:Nn \itemmarks_wue {1}}\\
            \seq_item:Nn \itemmarks_wue {2}
        }\\\\%endparbox
    }

    \seq_if_empty:NF \itemoptions_wue {
        \parbox[t]{\linewidth}{
        	\raggedright
            \textbf{\rule{0em}{1.5em} \seq_item:Nn \itemoptions_wue {1}}\\
            \seq_item:Nn \itemoptions_wue {2}
        }\\\\%endparbox
    }

    \seq_if_empty:NF \itembiomorphs_wue {
        \parbox[t]{\linewidth}{
        	\raggedright
            \textbf{\rule{0em}{1.5em} \seq_item:Nn \itembiomorphs_wue {1}}\\
