% cleasrs all the variables used with units
\cs_new:Nn \clearentrys_wue:n {%
	\seq_clear:N \itemname_wue
    \seq_clear:N \itempoints_wue
    \seq_clear:N \itemdescr_wue
    \seq_clear:N \itemnote_wue
    
    \int_zero:N \unitcount_wue
    \seq_clear:N \entryuvw_wue
    \seq_clear:N \itemunitname_wue
	\seq_clear:N \itemstatline_wue

    \seq_clear:N \itemcomposition_wue
	\seq_clear:N \itemunitcomp_wue
    \seq_clear:N \itemunittype_wue
    \seq_clear:N \itemwargear_wue

    \seq_clear:N \itemsrules_wue
    \seq_clear:N \itempsyker_wue
    \seq_clear:N \itemmarks_wue
    \seq_clear:N \itemoptions_wue
    \seq_clear:N \itembiomorphs_wue
    \seq_clear:N \itemleader_wue
    \seq_clear:N \itemvehicleupgrades_wue
    \seq_clear:N \itemtransport_wue
    \seq_clear:N \itemsupernote_wue

    \tl_clear:N \tablebody_wue
}

