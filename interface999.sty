\ProvidesPackage{interface999}[November 11, 2022]

%interface999 is a companion package to be used with codex999 in order to print both unit and weapon statlines. It loads warhammerunitentry and warhammerweaponentry, and also includes some helper functions to bridge the two.

%it is for generating streamlining easy generation of weapon entries.


% \ProvidesPackage{warhammerweaponentry}[April 6, 2020]

%Warhammer weapon entry is a extraction of my warhammer weapon entry written a long time ago in expl3 as part of
%my ubiquitous "codex" class.

%it is for generating streamlining easy generation of weapon entries.

\RequirePackage{warhammerunitentry}
\RequirePackage{warhammerweaponentry}

\RequirePackage{xparse}%allows complex command define commands

\RequirePackage[breakable]{tcolorbox}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%COMMANDS OF CONVENIENCE%%%%%%%%%%%%%%%%%%%%%%



\NewDocumentCommand{\red}{+m}{{\color{red} #1}}
\NewDocumentCommand{\dev}{+m}{{\color{magenta} #1}}
\NewDocumentCommand{\notebox}{+m}{\begin{tcolorbox} #1 \end{tcolorbox}}

\NewDocumentEnvironment{redd}{+b}{
    \color{red}
    #1
}

\NewDocumentEnvironment{noteboxx}{+b}{
    \begin{tcolorbox}
    #1
    \end{tcolorbox}
}

\NewDocumentEnvironment{highlightt}{+b}{
    \begin{tcolorbox}[%
        % fontupper = \ttfamily,
        colback=gray!50!yellow!20,
        colframe=gray!50!yellow!20,
        center,
        width = \linewidth - 0.125in,
        arc = 0pt,
        outer arc=0pt,
        % left = 0pt,
        % right = 0pt,
        % top = 0pt,
        % bottom = 0pt,
        boxsep = -4pt,
        breakable
        ]%
    #1
    \end{tcolorbox}
}


\NewDocumentCommand{\highlight}{+m}{%
    \begin{tcolorbox}[%
        % fontupper = \ttfamily,
        colback=gray!50!yellow!20,
        colframe=gray!50!yellow!20,
        center,
        width = \linewidth - 0.125in,
        arc = 0pt,
        outer arc=0pt,
        % left = 0pt,
        % right = 0pt,
        % top = 0pt,
        % bottom = 0pt,
        boxsep = -4pt,
        breakable
        ]%
    #1
    \end{tcolorbox}
}




%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%##EXPL3 DESIGN SPACE%%%%%%%%%%%%%%%%%%%%%%%%#

\ExplSyntaxOn


\NewDocumentCommand{\name}{s+m} {%set command for names
    \wname{#2}
    \uname{#2}
}

\NewDocumentCommand{\warp}{s+m} {%set command for warp power level
    \wwarp{#2}
}

\NewDocumentCommand{\descr}{s+m} {%set command for descriptions
    \wdescr{#2}
    \udescr{#2}
}
\NewDocumentCommand{\note}{s+m} {%set command for notes
    \wnote{#2}
    \unote{#2}
}

% \fp_new:N \mytempfloat

\NewDocumentCommand{\cost}{m}{%
    \fp_compare:nTF {#1 = 0}{%if 0 replace with free
        \dotfill ~ free%
    }{\fp_compare:nTF {#1 <= 1}{% s or no s
        \dotfill ~ #1~point%
        }{\dotfill ~ #1~points%
        }
    }
}



\ExplSyntaxOff

