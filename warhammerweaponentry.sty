}

\NewDocumentCommand{\makepower}{}{
    \group_begin:
    \tl_if_empty:NF \itemname_wwe {%
        {\color{black}\sffamily\bfseries \tl_use:N \itemname_wwe \dotfill Warp~Level~\tl_use:N \itemwarp_wwe}\par\nobreak
        % \vspace{1.5pt plus 0.5pt minus 0.5pt}
    }
    \tl_if_empty:NF \itemdescr_wwe {%
        \textit{\tl_use:N \itemdescr_wwe}\par
        % \vspace{5pt plus 0.5pt minus 0.5pt}
    }
    \tl_if_empty:NF \itemnote_wwe {%
        \tl_use:N \itemnote_wwe\par
    }
    \int_compare:nF {\weaponcount_wwe=0}{%if no weapons dont print
        \int_compare:nTF {\isnamed_wwe=0}{%prints table, named or unnamed
            \unnamed_weapon_wwe:n {}
        }{
            \named_weapon_wwe:n {}
        }
    }
    \int_compare:nTF {\wrulescount_wwe=0}{
    }{
        \par\printwrules_wwe:n {}
    }
    % \vspace*{5pt plus 1pt minus 1pt}
    \vspace{10pt plus 1pt minus 1pt}
    \group_end:
    \clearweapons_wwe:n {}%clears an resets all variables for next usage.
}


\NewDocumentCommand{\weapon}{smmmmm} {% #1 = star (case of weapon subtype)
    \int_compare:nT {\juststarted_wwe=0} {
        \tl_if_empty:nTF {#2} {%if the first entry has no name, the whole table will be nameless
            \int_set:Nn \isnamed_wwe {0}
        }{
            \int_set:Nn \isnamed_wwe {1}
        }
        \int_set:Nn \juststarted_wwe {1}%this will be turned back to 0 at the end of makeweapon
    }
    \bool_if:NTF #1 {%flips color when needed
        \int_set:Nn {\tocolor_wwe} {\tocolor_wwe}
    }{
        \int_set:Nn {\tocolor_wwe} {-1*\tocolor_wwe}
    }
    \seq_put_right:Nx \tocolorrow_wwe {\int_use:N \tocolor_wwe}
    \seq_put_right:Nn \weaponnames_wwe {#2}
    \seq_put_right:Nn \range_wwe{#3}
    \seq_put_right:Nn \strength_wwe {#4}
    \seq_put_right:Nn \armourpen_wwe {#5}
    \seq_put_right:Nn \type_wwe {#6}
    \int_incr:N \weaponcount_wwe
}



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\NewDocumentCommand{\makeweapon}{}{
    \group_begin:
    \tl_if_empty:NF \itemname_wwe {%prints the weapon name
        {\color{black}\sffamily\bfseries \tl_use:N \itemname_wwe}\par\nobreak
        % \vspace*{1.5pt plus 0.5pt minus 0.5pt}
    }
    \tl_if_empty:NF \itemdescr_wwe {%prints the weapon description
        \textit{\tl_use:N \itemdescr_wwe}\par
        % \vspace*{5pt plus 0.5pt minus 0.5pt}
    }
    \tl_if_empty:NF \itemnote_wwe {%prints the weapon note
        \tl_use:N \itemnote_wwe\par
        % \vspace*{2.5pt plus 0.5pt minus 0.5pt}
    }
    \int_compare:nTF {\isnamed_wwe=0}{%prints table, named or unnamed
        \unnamed_weapon_wwe:n {}
    }{
        \named_weapon_wwe:n {}
    }
    % \\\vspace*{2.5pt plus 0.5pt minus 0.5pt}
    \int_compare:nTF {\wrulecount_wwe=0}{
    }{
        \par\printwrule_wwe:n {}
    }
    \int_compare:nTF {\wrulescount_wwe=0}{
    }{
        \par\printwrules_wwe:n {}
    }
    % \vspace*{5pt plus 1pt minus 1pt}
    \vspace{10pt plus 1pt minus 1pt}
    \group_end:
    \clearweapons_wwe:n {}%clears an resets all variables for next usage.
}

