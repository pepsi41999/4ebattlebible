\cs_new_protected:Nn \unnamed_weapon_wwe:n {%responsible for generating the table for unnamed weapons
    \setlength{\tabcolsep}{0pt}
    \renewcommand{\arraystretch}{1.2}
    %Table settings for un-named entrys, R C C T
    \newcolumntype{R}{>{\hsize=0.2\linewidth \centering\arraybackslash}X}%
    \newcolumntype{C}{>{\hsize=0.175\linewidth \centering\arraybackslash}X}%
    \newcolumntype{T}{>{\hsize=0.475\linewidth \raggedright\arraybackslash}X}%
    
    % the table preamble
    \tl_set:Nn \tablebody_wwe {
        \begin{tabularx}{1.00\linewidth}{ R C C T }
        \textbf{Range} & \textbf{S}& \textbf{AP}& \textbf{Type}\\
        \hline
    }

    %build rows
    \int_step_inline:nnnn { 1 } { 1 } {\weaponcount_wwe}{
        \int_compare:nNnT {\seq_item:Nn \tocolorrow_wwe {##1}}{=}{1}{
            \tl_put_right:Nn \tablebody_wwe {\rowcolor{mycellcolor}}
        }
        \tl_put_right:Nn \tablebody_wwe {
            \seq_item:Nn \range_wwe {##1} &
            \seq_item:Nn \strength_wwe {##1} &
            \seq_item:Nn \armourpen_wwe {##1} &
            \seq_item:Nn \type_wwe {##1} \\
        }
    }
    \tl_put_right:Nn \tablebody_wwe { \end{tabularx} } % end of the table
    \tl_use:N \tablebody_wwe % print the table
}

%obsolete, left here so older documents still compile.
\cs_new_protected:Nn \printwrule_wwe:n {
    \int_step_inline:nnnn { 0 } { 1 } {\wrulecount_wwe - 1}{
        \textbf{\seq_item:Nn \itemwrule_wwe {##1 * 2 + 1} : }
        {~} \seq_item:Nn \itemwrule_wwe {##1 * 2 + 2}\\
    }
}


%this funtion is the new one, it can build as many as you want
\cs_new_protected:Nn \printwrules_wwe:n {
    \int_step_inline:nnnn { 0 } { 1 } {\wrulescount_wwe - 1}{
        \tl_set:Nf \templist_wwe {\seq_item:Nn \itemwrules_wwe {##1 * 2 + 1}}
        % \tl_set:Nf \templista_wwe {\seq_item:Nn \itemwrules_wwe {##1 * 2 + 1}}
        \tl_set:Nf \templista_wwe {}
        \tl_if_eq:NNF \templist_wwe \templista_wwe {
            \textbf{\tl_use:N \templist_wwe : {~} }
            % \textbf{\seq_item:Nn \itemwrules_wwe {##1 * 2 + 1} : {~} }
        }
        \seq_item:Nn \itemwrules_wwe {##1 * 2 + 2}
        \int_compare:nT{##1 != \wrulescount_wwe - 1}{
            \\
        }
    }
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_new_protected:Nn \named_weapon_wwe:n {%responsible for generating the table for named weapons
    \setlength{\tabcolsep}{0pt}
    \renewcommand{\arraystretch}{1.2}
    %Table settings for named entrys, N C C C T
    \newcolumntype{N}{>{\hsize=0.4\linewidth \raggedright\arraybackslash}X}%
    \newcolumntype{R}{>{\hsize=0.175\linewidth \centering\arraybackslash}X}%
    \newcolumntype{C}{>{\hsize=0.15\linewidth \centering\arraybackslash}X}%
    \newcolumntype{T}{>{\hsize=0.3\linewidth \raggedright\arraybackslash}X}%
    
    % the table preamble
    \tl_set:Nn \tablebody_wwe {
        \begin{tabularx}{1.00\linewidth}{ N R C C T }
        & \textbf{Range} & \textbf{S}& \textbf{AP}& \textbf{Type}\\
        \hline
    }

    %build rows
    \int_step_inline:nnnn { 1 } { 1 } {\weaponcount_wwe}{
        \int_compare:nNnT {\seq_item:Nn \tocolorrow_wwe {##1}}{=}{1}{
            \tl_put_right:Nn \tablebody_wwe {\rowcolor{mycellcolor}}
        }
        \tl_put_right:Nn \tablebody_wwe {
            \seq_item:Nn \weaponnames_wwe {##1} &
            \seq_item:Nn \range_wwe {##1} &
            \seq_item:Nn \strength_wwe {##1} &
            \seq_item:Nn \armourpen_wwe {##1} &
            \seq_item:Nn \type_wwe {##1} \\
        }
    }
    \tl_put_right:Nn \tablebody_wwe { \end{tabularx} } % end of the table
    \tl_use:N \tablebody_wwe % print the table
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\cs_new:Nn \clearweapons_wwe:n {%this rule clears all the variables so they dont get printed again on accident if not overridden by the next entry,
    \tl_clear:N \itemname_wwe%
    \tl_clear:N \itemwarp_wwe%
    \tl_clear:N \itemdescr_wwe%
    \tl_clear:N \itemnote_wwe%
    %
    \int_zero:N \wrulecount_wwe%
    \seq_clear:N \itemwrule_wwe%
    \int_zero:N \wrulescount_wwe%
    \seq_clear:N \itemwrules_wwe%
    %
    \seq_clear:N \tocolorrow_wwe%
    \int_set:Nn \juststarted_wwe {0}%
    \int_set:Nn \tocolor_wwe {1}%
    % \int_set:Nn \isnamed {1}%This does not need to be cleared
    %
    \seq_clear:N \weaponnames_wwe%
    \seq_clear:N \range_wwe%
    \seq_clear:N \strength_wwe%
    \seq_clear:N \armourpen_wwe%
    \seq_clear:N \type_wwe%
    \int_zero:N \weaponcount_wwe%
    %
    \tl_clear:N \tablebody_wwe%
    \tl_clear:N \templist_wwe%
    \tl_clear:N \templista_wwe%
    \tl_clear:N \templistb_wwe%
}


