%Warhammer weapon entry is a extraction of my warhammer weapon entry written a long time ago in expl3 as part of
%my ubiquitous "codex" class.

%it is for generating streamlining easy generation of weapon entries.


\RequirePackage{tabularx} 			%more tables
\RequirePackage{colortbl}           %for row colors and the like
    \definecolor{mycellcolor}{rgb}{0.88,1,1}    %defines a light teal color for cells



\RequirePackage[dvipsnames,table]{xcolor}


\RequirePackage{xparse}%allows complex command define commands

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%##EXPL3 DESIGN SPACE%%%%%%%%%%%%%%%%%%%%%%%%#

\ExplSyntaxOn


%%%%%%%%%%%

%*******************************************arrays*******************************************************%
%sequnces are indexible data structures



%These five attributes store weapon data as it is parsed in with  \weapon{name}{range}{strength}{armourpen}{type}
\seq_new:N \weaponnames_wwe%stores the weapon names for the table entries
\seq_new:N \range_wwe%
\seq_new:N \strength_wwe%
\seq_new:N \armourpen_wwe%
\seq_new:N \type_wwe%

\seq_new:N \itemwrule_wwe %every other 'entity' is rule/name
\seq_new:N \itemwrules_wwe

\seq_new:N \tocolorrow_wwe%array for final table row colors 


%*******************************************tokenlists***************************************************%
\tl_new:N \itemname_wwe%used to store the weapon title
\tl_new:N \itemwarp_wwe%used to store the weapon title
\tl_new:N \itemdescr_wwe%used to store the description
\tl_new:N \itemnote_wwe%used to store a note between the description and the main table

\tl_new:N \tablebody_wwe%used to the table as it is generated and then printed
\tl_new:N \templist_wwe
\tl_new:N \templista_wwe
\tl_new:N \templistb_wwe


%*******************************************counters*****************************************************%

\int_new:N \weaponcount_wwe \int_set:Nn \weaponcount_wwe {0}%keeps track of how many weapons are in the table

\int_new:N \wrulecount_wwe \int_set:Nn \wrulecount_wwe {0}%keeps track of how many special rules to print.
\int_new:N \wrulescount_wwe \int_set:Nn \wrulescount_wwe {0}%keeps track of how many special rules to print.


%*******************************************booleans*****************************************************%
\int_new:N \tocolor_wwe            % 1 = white, !1 = mycellcolor
    \int_set:Nn {\tocolor_wwe} {1}    % initially white


%if the first entry has the name field not populated, the table will be printed without names
%this is common for weapons with only 1 entry in their table.
\int_new:N \juststarted_wwe%used to test first entry for isnamed condition
\int_new:N \isnamed_wwe%result of isnamed condition check

%********************************Global_variable_storage_commands****************************************%
\NewDocumentCommand{\wname}{s+m} {%set command for names
    \tl_set:Nn \itemname_wwe {#2}
}

\NewDocumentCommand{\wwarp}{s+m} {%set command for warp level
    \tl_set:Nn \itemwarp_wwe {#2}
}

\NewDocumentCommand{\wdescr}{s+m} {%set command for descriptions
    \tl_set:Nn \itemdescr_wwe {#2}
}
\NewDocumentCommand{\wnote}{s+m} {%set command for notes
    \tl_set:Nn \itemnote_wwe {#2}
}

\NewDocumentCommand{\wrule}{sm+m} {%set command for weapon rules
    \seq_put_right:Nn \itemwrule_wwe {#2}
    \seq_put_right:Nn \itemwrule_wwe {#3}
    \int_incr:N \wrulecount_wwe
}

\NewDocumentCommand{\wrules}{sO{}+m} {
    \seq_put_right:Nn \itemwrules_wwe {#2}
    \seq_put_right:Nn \itemwrules_wwe {#3}
    \int_incr:N \wrulescount_wwe
}


